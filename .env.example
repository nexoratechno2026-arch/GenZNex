# Firebase Client Config (Safe for browser / public)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-genznex
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForEmulatorTestingOnly
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-genznex.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-genznex.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase Emulator Hosts & Ports
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Razorpay Local Emulator Secrets (Strictly Server-Side Only - never expose to client!)
RAZORPAY_KEY_ID=rzp_test_emulator_key
RAZORPAY_KEY_SECRET=rzp_test_emulator_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_emulator_webhook_secret
