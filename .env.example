# ==============================================================================
# GENZNEX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL SECRETS OR SERVICE ACCOUNT KEYS TO VERSION CONTROL.
# Copy this file to .env.local for local emulator development.
# ==============================================================================

# --- 1. Target Environment & App URL ---
# Values: dev | staging | prod
APP_ENV=dev
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 2. Firebase Public Client Configuration (Safe for Browser) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-genznex
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForEmulatorTestingOnly
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-genznex.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-genznex.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- 3. Firebase Emulator Hosts & Ports (Local Development Only) ---
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

# --- 4. Firebase App Check (reCAPTCHA Enterprise) ---
# Set debug token for local emulator/dev testing; use real reCAPTCHA key on staging & prod
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key_here
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=true

# --- 5. Razorpay Configuration ---
# Public Key ID (Required by Razorpay Checkout script in browser)
# Test: rzp_test_* | Live: rzp_live_*
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_emulator_key

# --- 6. Cloud Functions Secrets (Production: Configured via Firebase Secret Manager) ---
# In Cloud Functions, secrets are defined with defineSecret() and injected at runtime.
# For local emulator testing only, these are loaded from .env.local:
RAZORPAY_KEY_ID=rzp_test_emulator_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- 7. Transactional Email Provider (Resend / SendGrid / Postmark) ---
# Secret Manager in Cloud Functions:
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM_DOMAIN=notifications.genznex.in
EMAIL_SUPPORT_ADDRESS=support@genznex.in

# --- 8. Video Delivery Provider (Mux / Bunny / Vimeo) ---
# Secret Manager in Cloud Functions:
VIDEO_PROVIDER_SIGNING_KEY=your_video_token_signing_key_here
VIDEO_PROVIDER_LIBRARY_ID=your_video_library_id_here

# --- 9. Observability & Error Monitoring (Sentry / Google Cloud Monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your_sentry_ci_auth_token_here
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- 10. SMS / WhatsApp Notifications (Optional Stub behind feature flag) ---
SMS_GATEWAY_AUTH_KEY=your_sms_gateway_key_here
WHATSAPP_BUSINESS_API_TOKEN=your_whatsapp_token_here
